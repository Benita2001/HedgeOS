# Copy to .env and fill in. Never commit .env.
# Execution mode: "paper" simulates fills against real live market data (default, safe).
# "live" places real orders and REQUIRES real Binance API credentials with trade permission.
HEDGEOS_MODE=paper

# Only required for HEDGEOS_MODE=live. Create these yourself in your Binance account
# (Agentic sub-account recommended, with Market Data + Account + Trade scopes, NO Transfer/Withdraw).
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Local SQLite file
HEDGEOS_DB_PATH=./data/hedgeos.db

# HedgeOS MCP server port (stdio by default; HTTP fallback for dashboard use)
HEDGEOS_MCP_PORT=8765
HEDGEOS_DASHBOARD_PORT=8766
