# Copy to .env and fill in. Never commit .env.
# Execution mode: "paper" simulates fills against real live market data (default, safe).
# "live" requires ALL FOUR of the live-trading gate vars below AND real credentials — see LIVE_TRADING_READINESS.md.
HEDGEOS_MODE=paper

# --- Live trading gate (leave all four blank/unset for paper mode — this is the default and recommended state) ---
# Every one of these is required, independently, before LiveExecutionAdapter will even construct.
# Complete the full checklist in LIVE_TRADING_READINESS.md before setting any of them.
# HEDGEOS_LIVE_TRADING_CONFIRMED=I_UNDERSTAND_THE_RISK
# HEDGEOS_LIVE_CHECKLIST_COMPLETE=yes
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# Optional: hedge leverage used by the live adapter (2 default, 3 the only other approved value).
# HEDGEOS_LIVE_HEDGE_LEVERAGE=2

# Note: BINANCE_API_KEY/SECRET alone (without the two confirmation vars above) are enough to run
# the READ-ONLY funding-readiness check (`check_funding_readiness` MCP tool, scripts/live-preflight.ts)
# without enabling live trading at all — see docs/FUNDING_READINESS.md.

# Create your Binance API key yourself, in the Binance UI, with least privilege:
# Spot + Margin + Futures TRADE scope, withdrawal DISABLED, internal-transfer DISABLED, IP-restricted
# to the host that will actually use it. See docs/LIVE_PREFLIGHT_SETUP.md for how to install it securely
# (never through chat, never in a shared multi-user config).

# Local SQLite file
HEDGEOS_DB_PATH=./data/hedgeos.db

# Worker tick interval (ms)
HEDGEOS_TICK_MS=60000

# Dashboard (read-only). Binds to loopback by default — do not change HEDGEOS_DASHBOARD_HOST
# to 0.0.0.0 without your own reverse proxy + auth in front of it; the dashboard has none of its own.
HEDGEOS_DASHBOARD_PORT=8766
HEDGEOS_DASHBOARD_HOST=127.0.0.1
